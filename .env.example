# GBP (mismas variables que usa GBPClient)
ERP_URL=              # URL de login de GBP
ERP_USER=             # cuenta dedicada "Vendedor Corporativo"
ERP_PASSWORD=

# CRM (bot de presupuestos)
CRM_BASE_URL=https://crm-argcolor-production.up.railway.app
BOT_TOKEN=            # = GBP_BOT_TOKEN de Railway
POLL_INTERVAL_SECONDS=20
HEADLESS=false

# Opcionales de GBP
GBP_PERFIL=           # vacío = usar el perfil que ya tiene la cuenta
GBP_SUCURSAL=         # value de #ddlBranch; vacío = no tocar
GBP_TIMEOUT_SECONDS=30

# Comportamiento del bot
DRY_RUN=false         # true: carga todo, saca captura y NO guarda (reporta /error "DRY-RUN")
HORA_INICIO=08:00     # fuera de este horario no toma jobs
HORA_FIN=18:50       # la PC se apaga ~19 h: margen para terminar el job en curso
